.container__form {
    display: flex;
    flex-direction: column;
    align-content: flex-start;
    flex-wrap: wrap;
}

p {
    margin-left: 30px;
}

input {
    margin-left: 30px;
}

h1 {
    margin-left: 30px;
}

.btn {
    margin-top: 5px;
    margin-left: 40px;
    box-shadow: none;
    border: none;
    font-family: inherit;
    background-color: #3f51b5;
    color: #ffffff;
    border-radius: 5px;
    padding: 5px 10px;
    margin-right: 20px;
}